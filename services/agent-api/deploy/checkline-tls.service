[Unit]
Description=CheckLine private API HTTPS proxy
Wants=network-online.target
After=network-online.target checkline-agent.service

[Service]
Type=notify
User=checkline-tls
Group=checkline-tls
Environment=XDG_DATA_HOME=/var/lib/checkline-tls
Environment=XDG_CONFIG_HOME=/var/lib/checkline-tls
ExecStart=/opt/checkline-agent/caddy/caddy run --config /etc/checkline-tls/Caddyfile --adapter caddyfile
Restart=on-failure
RestartSec=5
TimeoutStopSec=10
LimitNOFILE=1048576
LimitCORE=0
UMask=0077
AmbientCapabilities=CAP_NET_BIND_SERVICE
CapabilityBoundingSet=CAP_NET_BIND_SERVICE
NoNewPrivileges=true
PrivateTmp=true
PrivateDevices=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/lib/checkline-tls

[Install]
WantedBy=multi-user.target
