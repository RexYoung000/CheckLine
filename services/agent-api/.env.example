# Configure only on the server. Never copy secrets into the App or repository.
DEEPSEEK_API_KEY=
AGENT_API_TOKEN=
# Optional private-test expiry, ISO 8601 (for example 2026-10-23T00:00:00Z).
# Leave absent for existing deployments; public user authentication is separate.
# AGENT_API_TOKEN_EXPIRES_AT=
PORT=8787
# Native Node defaults to loopback. Docker sets its own container bind address.
